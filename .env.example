# Public URL
NEXT_PUBLIC_SITE_URL=https://agendapiena.ai

# PostgreSQL: Supabase pooler or Neon connection string
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# Admin access (use a long random password in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-at-least-32-random-characters
CRON_SECRET=generate-another-long-random-secret
DEFAULT_ORGANIZATION_NAME=Il nome del centro
DEFAULT_ORGANIZATION_SLUG=il-nome-del-centro
DEFAULT_ORGANIZATION_CITY=Milano
DEFAULT_OWNER_NAME=Nome titolare

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
