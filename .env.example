# PostgreSQL: Supabase pooler or Neon connection string
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
# Neon: connessione diretta consigliata per drizzle-kit e migrazioni
DIRECT_DATABASE_URL=postgresql://user:password@host/postgres?sslmode=require

# Admin access (use a long random password in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-at-least-32-random-characters
CRON_SECRET=generate-another-long-random-secret
# Cifra chiavi API e token delle integrazioni salvate nel database
INTEGRATION_ENCRYPTION_KEY=generate-a-different-random-secret-at-least-32-characters
DEFAULT_ORGANIZATION_NAME=Il nome del centro
DEFAULT_ORGANIZATION_SLUG=il-nome-del-centro
DEFAULT_ORGANIZATION_CITY=Milano
DEFAULT_OWNER_NAME=Nome titolare
SEED_DEMO_DATA=false

# Autenticazione multi-cliente consigliata. Gli utenti Auth devono avere
# la stessa email dei record nella tabella members.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo server: necessaria per inviare inviti al team. Non usare mai NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_DRAFTS_ENABLED=false

# Assistente vocale: Retell gestisce la chiamata; OpenRouter genera configurazioni e test
RETELL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini

# Calendario Cal.com: ogni cliente collega la propria chiave dall'area admin.
# Questi valori globali non sono necessari; la chiave cifrata resta nel database.

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Template Meta approvato, con un solo parametro nel corpo: {{1}}
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=it

# Stripe
STRIPE_SECRET_KEY=
# Prezzi ricorrenti mensili creati nel catalogo Stripe
STRIPE_PRICE_AGENDA_CLIENTI=
STRIPE_PRICE_TUTTO_IN_UNO=
STRIPE_PRICE_VOCE_BASE=
STRIPE_PRICE_VOCE_ATTIVITA=
STRIPE_PRICE_VOCE_AZIENDA=
# Prezzi una tantum per la configurazione iniziale
STRIPE_PRICE_SETUP_AGENDA_CLIENTI=
STRIPE_PRICE_SETUP_TUTTO_IN_UNO=
STRIPE_PRICE_SETUP_VOCE_BASE=
STRIPE_PRICE_SETUP_VOCE_ATTIVITA=
STRIPE_PRICE_SETUP_VOCE_AZIENDA=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Facoltativo: configurazione del portale con cambio piano e disdetta
STRIPE_PORTAL_CONFIGURATION_ID=

# Go-live: monitor esterno e conferma del backup Neon verificato
SENTRY_DSN=
HEALTHCHECK_MONITOR_URL=
BACKUP_POLICY_CONFIRMED=false
